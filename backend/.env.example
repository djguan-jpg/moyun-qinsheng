# Discord Developer Portal > OAuth2 / General
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=977834861761015808
# 「🎵｜音樂創作者」身分組 ID；留空即可暫時不驗證身分組。
DISCORD_PARTICIPANT_ROLE_ID=
# 可進入新報名服務管理後台的 Discord 使用者 ID，多位以逗號區隔。
DISCORD_ADMIN_USER_IDS=
# 必須與 Discord Developer Portal 設定完全相同。
# 現有主機部署時使用：https://moyun.161-33-185-80.sslip.io/guyun/auth/callback
DISCORD_REDIRECT_URI=http://localhost:8010/auth/callback
# 掛載在網域子路徑時填入，例如：/guyun；直接使用子網域或本機時留空。
PUBLIC_BASE_PATH=

# 請使用至少 32 字元的隨機字串，例如：python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-long-random-secret
APP_HOST=127.0.0.1
APP_PORT=8010
SESSION_HTTPS_ONLY=false
DATABASE_PATH=data/guyun-registration.sqlite3

# 台北時間；留空代表不設時程限制。正式上線請改成實際賽程。
REGISTRATION_START_AT=2026-08-25T12:00:00+08:00
REGISTRATION_END_AT=2026-09-12T23:59:00+08:00
